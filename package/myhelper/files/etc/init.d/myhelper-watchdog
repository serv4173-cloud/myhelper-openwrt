#!/bin/sh /etc/rc.common
#
# myhelper-watchdog - Watchdog + Game Boost for OpenWrt.
# Supports CAKE (4 presets) and HFSC-based game_boost preset.
#

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/myhelper_wd
NFT_TABLE="myhelper_qos"
IFB_DEV="ifb-myhelper"
GAMING_IP_FILE="/tmp/myhelper_gaming_ip"

EXTRA_COMMANDS="apply_qos speedtest"
EXTRA_HELP="        apply_qos   Re-apply gaming QoS rules (nft + tc)
        speedtest   Measure current upload/download speed"

# ---------------------------------------------------------------------------
# procd service lifecycle
# ---------------------------------------------------------------------------
start_service() {
    config_load myhelper
    config_get check_interval watchdog check_interval 60
    config_get fail_threshold watchdog fail_threshold 3
    config_get wan_iface      watchdog wan_interface  wan

    procd_open_instance myhelper
    procd_set_param command "$PROG" -f \
        -i "$check_interval" \
        -t "$fail_threshold" \
        -w "$wan_iface"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    apply_bbr
    apply_qos
}

stop_service() {
    cleanup_qos
    rm -f "$GAMING_IP_FILE"
    logger -t myhelper-watchdog "service stopping"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "myhelper"
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
resolve_wan_dev() {
    local uci_iface="$1"
    local dev=""

    if command -v ubus >/dev/null 2>&1; then
        dev=$(ubus call network.interface."$uci_iface" status 2>/dev/null \
              | jsonfilter -e '@.l3_device' 2>/dev/null)
    fi
    [ -n "$dev" ] || dev=$(uci -q get network."$uci_iface".ifname)
    [ -n "$dev" ] || dev="$uci_iface"
    echo "$dev"
}

resolve_mac_to_ip() {
    local target_mac="$1"
    local target_ip="$2"   # "ipv4" or "ipv6"
    local json dev idx mac ip key

    target_mac=$(echo "$target_mac" | tr 'A-Z' 'a-z')

    if [ "$target_ip" = "ipv6" ]; then
        json=$(ubus call dhcp ipv6leases 2>/dev/null) || return 1
        key="ip6"
    else
        json=$(ubus call dhcp ipv4leases 2>/dev/null) || return 1
        key="ip"
    fi

    [ -n "$json" ] || return 1

    for dev in br-lan br-guest br-iot; do
        idx=0
        while :; do
            mac=$(echo "$json" | jsonfilter \
                  -e "@.device['$dev'].leases[$idx].mac" 2>/dev/null)
            [ -z "$mac" ] && break
            if [ "$(echo "$mac" | tr 'A-Z' 'a-z')" = "$target_mac" ]; then
                echo "$json" | jsonfilter \
                    -e "@.device['$dev'].leases[$idx].${key}" 2>/dev/null
                return 0
            fi
            idx=$((idx + 1))
        done
    done

    idx=0
    while :; do
        mac=$(echo "$json" | jsonfilter -e "@.leases[$idx].mac" 2>/dev/null)
        [ -z "$mac" ] && break
        if [ "$(echo "$mac" | tr 'A-Z' 'a-z')" = "$target_mac" ]; then
            echo "$json" | jsonfilter -e "@.leases[$idx].${key}" 2>/dev/null
            return 0
        fi
        idx=$((idx + 1))
    done

    return 1
}

cleanup_qos() {
    nft delete table inet "$NFT_TABLE" 2>/dev/null

    local wan_iface wan_dev
    wan_iface=$(uci -q get myhelper.game_boost.wan_iface)
    [ -n "$wan_iface" ] || wan_iface="wan"
    wan_dev=$(resolve_wan_dev "$wan_iface")

    [ -n "$wan_dev" ] && {
        tc qdisc del dev "$wan_dev" root 2>/dev/null
        tc qdisc del dev "$wan_dev" ingress 2>/dev/null
    }
    ip link del "$IFB_DEV" 2>/dev/null

    logger -t myhelper-watchdog "QoS rules cleaned up"
}

# ---------------------------------------------------------------------------
# BBR congestion control
# ---------------------------------------------------------------------------
apply_bbr() {
    config_load myhelper
    config_get bbr_enabled game_boost bbr_enabled 0

    if [ "$bbr_enabled" = "1" ]; then
        modprobe tcp_bbr 2>/dev/null
        sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
        sysctl -w net.core.default_qdisc=cake >/dev/null 2>&1
        logger -t myhelper-watchdog "BBR enabled"
    else
        sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1
        logger -t myhelper-watchdog "BBR disabled (using cubic)"
    fi
}

# ---------------------------------------------------------------------------
# CAKE preset -> tc flag mapping
# ---------------------------------------------------------------------------
cake_preset_flags() {
    case "$1" in
        balanced)
            echo "diffserv4 triple-isolate nat wash ack-filter"
            ;;
        low_latency)
            echo "diffserv8 dual-srchost nat ack-filter"
            ;;
        max_throughput)
            echo "besteffort triple-isolate nat wash"
            ;;
        custom)
            config_get custom_flags game_boost custom_cake_flags ""
            echo "$custom_flags"
            ;;
        *)
            echo "diffserv4 triple-isolate nat wash ack-filter"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Link layer adaptation suffix for CAKE
# ---------------------------------------------------------------------------
cake_linklayer_suffix() {
    local ll="$1" oh="$2"
    local s=""
    [ -n "$oh" ] && [ "$oh" != "0" ] && s="overhead $oh"
    [ -n "$ll" ] && [ "$ll" != "none" ] && s="$s linklayer $ll"
    echo "$s"
}

# ---------------------------------------------------------------------------
# HFSC + pfifo + CAKE (game_boost preset)
# ---------------------------------------------------------------------------
apply_hfsc_game_boost() {
    local dev="$1"
    local total_bw="$2"     # kbit total (from bandwidth_upload)
    local game_bw="$3"      # kbit guaranteed for games
    local pfifo_limit="$4"
    local linklayer="$5"
    local overhead="$6"

    [ -n "$total_bw" ] && [ "$total_bw" != "0" ] || {
        logger -t myhelper-watchdog "HFSC: bandwidth_upload not set, skipping"
        return 1
    }

    # Convert from "20mbit" UCI value to plain number if needed
    case "$total_bw" in
        *mbit) total_bw=$(echo "$total_bw" | sed 's/mbit//'); total_bw=$((total_bw * 1000)) ;;
        *kbit) total_bw=$(echo "$total_bw" | sed 's/kbit//') ;;
    esac

    local cake_ll_suffix
    cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")

    logger -t myhelper-watchdog \
        "HFSC game_boost: total=${total_bw}kbit game=${game_bw}kbit pfifo=$pfifo_limit"

    # Root qdisc: HFSC
    tc qdisc del dev "$dev" root 2>/dev/null
    tc qdisc add dev "$dev" root handle 1: hfsc default 30

    # Class 1:1 - Game traffic (guaranteed bw)
    tc class add dev "$dev" parent 1: classid 1:1 hfsc \
        sc rate "${game_bw}kbit" ul rate "${game_bw}kbit"

    # Class 1:30 - Everything else
    tc class add dev "$dev" parent 1: classid 1:30 hfsc \
        sc rate "${total_bw}kbit" ul rate "${total_bw}kbit"

    # Game class qdisc: pfifo with small limit => low latency
    tc qdisc add dev "$dev" parent 1:1 handle 10: pfifo limit "$pfifo_limit"

    # Bulk class qdisc: CAKE
    # shellcheck disable=SC2086
    tc qdisc add dev "$dev" parent 1:30 handle 20: cake \
        bandwidth "${total_bw}kbit" \
        diffserv4 nat ack-filter $cake_ll_suffix \
        memlimit 32mb \
        || logger -t myhelper-watchdog "CAKE under HFSC failed"

    logger -t myhelper-watchdog "HFSC game_boost applied on $dev"
    return 0
}

# ---------------------------------------------------------------------------
# Game Boost: DSCP marking (nft) + CAKE shaping (tc)
# ---------------------------------------------------------------------------
apply_qos() {
    config_load myhelper
    config_get enabled    game_boost enabled             0
    config_get ports      game_boost ports               ""
    config_get wan_if     game_boost wan_iface           "wan"
    config_get bw_up      game_boost bandwidth_upload    "0"
    config_get bw_down    game_boost bandwidth_download  "0"
    config_get qos_preset game_boost qos_preset          "balanced"
    config_get game_bw    game_boost game_bandwidth_guarantee "8000"
    config_get pfifo_lim  game_boost game_pfifo_limit    "10"
    config_get linklayer  game_boost linklayer           "ethernet"
    config_get overhead   game_boost overhead            "34"

    if [ "$enabled" != "1" ]; then
        logger -t myhelper-watchdog "game_boost disabled, skipping QoS"
        rm -f "$GAMING_IP_FILE"
        return 0
    fi

    cake_flags=$(cake_preset_flags "$qos_preset")
    logger -t myhelper-watchdog \
        "applying game_boost preset=$qos_preset ports=[$ports]"

    # ----- 1. nftables: DSCP + meta priority (HFSC class 1:1) -------------
    nft delete table inet "$NFT_TABLE" 2>/dev/null
    nft add table inet "$NFT_TABLE"
    nft add chain inet "$NFT_TABLE" mark_out \
        '{ type filter hook postrouting priority mangle ; policy accept ; }'

    # Determine if we should set meta priority (only for game_boost preset)
    SET_PRIO=0
    [ "$qos_preset" = "game_boost" ] && SET_PRIO=1

    GAMING_IP_CAPTURED=""

    handle_target_mac() {
        local mac="$1"
        [ -n "$mac" ] || return 0

        # --- IPv4 ---
        local ip
        ip=$(resolve_mac_to_ip "$mac" "ipv4")
        if [ -n "$ip" ]; then
            [ -z "$GAMING_IP_CAPTURED" ] && GAMING_IP_CAPTURED="$ip"

            nft add rule inet "$NFT_TABLE" mark_out \
                ip saddr "$ip" ip dscp set cs6 \
                comment '"myhelper: game v4 src"'
            nft add rule inet "$NFT_TABLE" mark_out \
                ip daddr "$ip" ip dscp set cs6 \
                comment '"myhelper: game v4 dst"'

            if [ "$SET_PRIO" = "1" ]; then
                nft add rule inet "$NFT_TABLE" mark_out \
                    ip saddr "$ip" meta priority set 1:1 \
                    comment '"myhelper: game v4 to hfsc class 1:1"'
                nft add rule inet "$NFT_TABLE" mark_out \
                    ip daddr "$ip" meta priority set 1:1 \
                    comment '"myhelper: game v4 to hfsc class 1:1"'
            fi

            logger -t myhelper-watchdog "MAC $mac -> IPv4 $ip"
        else
            logger -t myhelper-watchdog "MAC $mac: no IPv4 lease"
        fi

        # --- IPv6 ---
        local ip6
        ip6=$(resolve_mac_to_ip "$mac" "ipv6")
        if [ -n "$ip6" ]; then
            nft add rule inet "$NFT_TABLE" mark_out \
                ip6 saddr "$ip6" ip6 dscp set cs6 \
                comment '"myhelper: game v6 src"'
            nft add rule inet "$NFT_TABLE" mark_out \
                ip6 daddr "$ip6" ip6 dscp set cs6 \
                comment '"myhelper: game v6 dst"'

            if [ "$SET_PRIO" = "1" ]; then
                nft add rule inet "$NFT_TABLE" mark_out \
                    ip6 saddr "$ip6" meta priority set 1:1 \
                    comment '"myhelper: game v6 to hfsc class 1:1"'
                nft add rule inet "$NFT_TABLE" mark_out \
                    ip6 daddr "$ip6" meta priority set 1:1 \
                    comment '"myhelper: game v6 to hfsc class 1:1"'
            fi

            logger -t myhelper-watchdog "MAC $mac -> IPv6 $ip6"
        fi
    }
    config_list_foreach game_boost target_mac handle_target_mac

    if [ -n "$GAMING_IP_CAPTURED" ]; then
        echo "$GAMING_IP_CAPTURED" > "$GAMING_IP_FILE"
    else
        rm -f "$GAMING_IP_FILE"
    fi

    # Port-based marking (v4 + v6)
    if [ -n "$ports" ]; then
        portset=$(echo "$ports" | tr ',' ' ')
        nft add rule inet "$NFT_TABLE" mark_out \
            tcp dport "{ $portset }" ip dscp set cs6 \
            comment '"myhelper: game tcp ports v4"'
        nft add rule inet "$NFT_TABLE" mark_out \
            udp dport "{ $portset }" ip dscp set cs6 \
            comment '"myhelper: game udp ports v4"'
        nft add rule inet "$NFT_TABLE" mark_out \
            tcp dport "{ $portset }" ip6 dscp set cs6 \
            comment '"myhelper: game tcp ports v6"'
        nft add rule inet "$NFT_TABLE" mark_out \
            udp dport "{ $portset }" ip6 dscp set cs6 \
            comment '"myhelper: game udp ports v6"'
    fi

    # ----- 2. Egress shaping ---------------------------------------------
    if [ "$bw_up" != "0" ] && [ -n "$bw_up" ]; then
        wan_dev=$(resolve_wan_dev "$wan_if")

        if [ "$qos_preset" = "game_boost" ]; then
            # HFSC path
            apply_hfsc_game_boost "$wan_dev" "$bw_up" "$game_bw" \
                                  "$pfifo_lim" "$linklayer" "$overhead"
        else
            # CAKE-only path
            cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")
            logger -t myhelper-watchdog \
                "cake egress dev=$wan_dev rate=$bw_up preset=$qos_preset"

            tc qdisc del dev "$wan_dev" root 2>/dev/null
            # shellcheck disable=SC2086
            tc qdisc add dev "$wan_dev" root cake \
                bandwidth "$bw_up" \
                $cake_flags $cake_ll_suffix \
                memlimit 32mb \
                || logger -t myhelper-watchdog "cake egress FAILED"
        fi
    fi

    # ----- 3. Ingress shaping via IFB (always CAKE) ----------------------
    if [ "$bw_down" != "0" ] && [ -n "$bw_down" ]; then
        wan_dev=$(resolve_wan_dev "$wan_if")
        cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")

        modprobe ifb 2>/dev/null
        ip link del "$IFB_DEV" 2>/dev/null
        ip link add "$IFB_DEV" type ifb 2>/dev/null || true
        ip link set "$IFB_DEV" up

        tc qdisc del dev "$wan_dev" ingress 2>/dev/null
        tc qdisc add dev "$wan_dev" handle ffff: ingress
        tc filter add dev "$wan_dev" parent ffff: protocol all u32 \
            match u32 0 0 \
            action mirred egress redirect dev "$IFB_DEV"

        tc qdisc del dev "$IFB_DEV" root 2>/dev/null
        # shellcheck disable=SC2086
        tc qdisc add dev "$IFB_DEV" root cake \
            bandwidth "$bw_down" \
            $cake_flags $cake_ll_suffix \
            memlimit 64mb \
            || logger -t myhelper-watchdog "cake ingress FAILED"

        logger -t myhelper-watchdog \
            "cake ingress dev=$wan_dev ifb=$IFB_DEV rate=$bw_down"
    fi

    logger -t myhelper-watchdog "game_boost applied OK"
}

# ---------------------------------------------------------------------------
# Speedtest: measure current up/down speed and store in UCI
# ---------------------------------------------------------------------------
speedtest() {
    logger -t myhelper-watchdog "starting speedtest..."

    if ! command -v speedtest-netperf >/dev/null 2>&1; then
        logger -t myhelper-watchdog \
            "speedtest-netperf not installed, installing..."
        opkg update >/dev/null 2>&1
        opkg install speedtest-netperf >/dev/null 2>&1 || {
            logger -t myhelper-watchdog "FAILED to install speedtest-netperf"
            return 1
        }
    fi

    OUT=$(speedtest-netperf -H netperf.bufferbloat.net 2>&1)

    DL=$(echo "$OUT" | grep -iE 'download' | grep -oE '[0-9]+\.[0-9]+' | head -1)
    UL=$(echo "$OUT" | grep -iE 'upload'   | grep -oE '[0-9]+\.[0-9]+' | head -1)

    [ -z "$DL" ] && DL=0
    [ -z "$UL" ] && UL=0

    # Convert Mbit -> kbit using awk (busybox-compatible)
    DL_KBIT=$(echo "$DL" | awk '{printf "%d", $1 * 1000}')
    UL_KBIT=$(echo "$UL" | awk '{printf "%d", $1 * 1000}')
    [ -z "$DL_KBIT" ] && DL_KBIT=0
    [ -z "$UL_KBIT" ] && UL_KBIT=0

    TS=$(date +%s)

    uci set myhelper.game_boost.speedtest_download="$DL_KBIT"
    uci set myhelper.game_boost.speedtest_upload="$UL_KBIT"
    uci set myhelper.game_boost.speedtest_timestamp="$TS"
    uci commit myhelper

    logger -t myhelper-watchdog \
        "speedtest done: down=${DL}Mbit up=${UL}Mbit"

    echo "DOWN=${DL}Mbit UP=${UL}Mbit"
}
