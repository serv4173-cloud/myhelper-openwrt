#!/bin/sh /etc/rc.common
#
# myhelper-watchdog - Watchdog + Game Boost for OpenWrt.
# Supports CAKE (4 presets) and HFSC-based game_boost preset.
#
# apply_qos() returns 0 on full success, non-zero if any tc/nft/ip command
# that SHOULD succeed failed. The C daemon propagates this rc to the
# "qos_reapply" ubus method ({ok, rc}).
#

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/myhelper_wd
NFT_TABLE="myhelper_qos"
IFB_DEV="ifb-myhelper"
GAMING_IP_FILE="/tmp/myhelper_gaming_ip"

EXTRA_COMMANDS="apply_qos speedtest"
EXTRA_HELP="        apply_qos   Re-apply gaming QoS rules (nft + tc)
        speedtest   Measure current upload/download speed"

# ---------------------------------------------------------------------------
# procd service lifecycle
# ---------------------------------------------------------------------------
start_service() {
    migrate_settings

    config_load myhelper
    config_get watchdog_enabled watchdog enabled 1

    if [ "$watchdog_enabled" != "1" ]; then
        logger -t myhelper-watchdog "watchdog disabled in UCI, not starting daemon"
    else
        config_get check_interval watchdog check_interval 60
        config_get fail_threshold watchdog fail_threshold 3
        config_get wan_iface      watchdog wan_interface  wan

        procd_open_instance myhelper
        procd_set_param command "$PROG" -f \
            -i "$check_interval" \
            -t "$fail_threshold" \
            -w "$wan_iface"
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
    apply_qos
}

stop_service() {
    cleanup_qos
    rm -f "$GAMING_IP_FILE"
    logger -t myhelper-watchdog "service stopping"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "myhelper"
}

# ---------------------------------------------------------------------------
# UCI schema migration: settings.enabled -> settings.game_boost_enabled
#
# "settings.enabled" historically meant Game Boost, but it collided with
# "watchdog.enabled" (different concern) and confused readers. The new
# name is explicit. Migration is idempotent.
# ---------------------------------------------------------------------------
migrate_settings() {
    local old_val new_val
    old_val=$(uci -q get myhelper.settings.enabled)
    new_val=$(uci -q get myhelper.settings.game_boost_enabled)

    if [ -n "$old_val" ] && [ -z "$new_val" ]; then
        uci set myhelper.settings.game_boost_enabled="$old_val"
        uci -q delete myhelper.settings.enabled
        uci commit myhelper
        logger -t myhelper-watchdog \
            "migrated settings.enabled=$old_val -> settings.game_boost_enabled"
    elif [ -n "$old_val" ] && [ -n "$new_val" ]; then
        uci -q delete myhelper.settings.enabled
        uci commit myhelper
        logger -t myhelper-watchdog \
            "removed duplicate settings.enabled (kept game_boost_enabled=$new_val)"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
resolve_wan_dev() {
    local uci_iface="$1"
    local dev=""

    if command -v ubus >/dev/null 2>&1; then
        dev=$(ubus call network.interface."$uci_iface" status 2>/dev/null \
              | jsonfilter -e '@.l3_device' 2>/dev/null)
    fi
    [ -n "$dev" ] || dev=$(uci -q get network."$uci_iface".ifname)
    [ -n "$dev" ] || dev="$uci_iface"
    echo "$dev"
}

resolve_mac_to_ip() {
    local target_mac="$1"
    local target_ip="$2"
    target_mac=$(echo "$target_mac" | tr 'A-Z' 'a-z')

    if [ -f /tmp/dhcp.leases ]; then
        local ip
        if [ "$target_ip" = "ipv6" ]; then
            ip=$(awk -v mac="$target_mac" \
                  'tolower($2) == mac { print $4; exit }' \
                  /tmp/dhcp.leases)
        else
            ip=$(awk -v mac="$target_mac" \
                  'tolower($2) == mac { print $3; exit }' \
                  /tmp/dhcp.leases)
        fi
        if [ -n "$ip" ] && [ "$ip" != "*" ]; then
            echo "$ip"
            return 0
        fi
    fi

    local json dev idx m key
    if [ "$target_ip" = "ipv6" ]; then
        json=$(ubus call dhcp ipv6leases 2>/dev/null)
        key="ip6"
    else
        json=$(ubus call dhcp ipv4leases 2>/dev/null)
        key="ip"
    fi
    [ -n "$json" ] || return 1

    for dev in br-lan br-guest br-iot; do
        idx=0
        while :; do
            m=$(echo "$json" | jsonfilter \
                -e "@.device['$dev'].leases[$idx].mac" 2>/dev/null)
            [ -z "$m" ] && break
            if [ "$(echo "$m" | tr 'A-Z' 'a-z')" = "$target_mac" ]; then
                echo "$json" | jsonfilter \
                    -e "@.device['$dev'].leases[$idx].${key}" 2>/dev/null
                return 0
            fi
            idx=$((idx + 1))
        done
    done

    return 1
}

cleanup_qos() {
    nft delete table inet "$NFT_TABLE" 2>/dev/null

    local wan_iface wan_dev
    wan_iface=$(uci -q get myhelper.settings.wan_iface)
    [ -n "$wan_iface" ] || wan_iface=$(uci -q get myhelper.game_boost.wan_iface)
    [ -n "$wan_iface" ] || wan_iface="wan"
    wan_dev=$(resolve_wan_dev "$wan_iface")

    [ -n "$wan_dev" ] && {
        tc qdisc del dev "$wan_dev" root 2>/dev/null
        tc qdisc del dev "$wan_dev" ingress 2>/dev/null
    }
    ip link del "$IFB_DEV" 2>/dev/null

    logger -t myhelper-watchdog "QoS rules cleaned up"
    return 0
}

# ---------------------------------------------------------------------------
# BBR congestion control (verified)
# ---------------------------------------------------------------------------
apply_bbr() {
    config_load myhelper
    config_get bbr_enabled settings bbr_enabled 0

    if [ "$bbr_enabled" != "1" ]; then
        sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1
        logger -t myhelper-watchdog "BBR disabled (using cubic)"
        return 0
    fi

    local current
    current=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    if [ "$current" = "bbr" ]; then
        logger -t myhelper-watchdog "BBR already active"
        return 0
    fi

    if ! modprobe tcp_bbr 2>/dev/null; then
        logger -t myhelper-watchdog \
            "BBR: modprobe tcp_bbr failed (module not in kernel build?)"
        return 1
    fi
    if ! sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1; then
        logger -t myhelper-watchdog "BBR: sysctl write failed"
        return 1
    fi
    current=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)
    if [ "$current" != "bbr" ]; then
        logger -t myhelper-watchdog \
            "BBR: kernel did not switch (current=$current)"
        return 1
    fi

    sysctl -w net.core.default_qdisc=cake >/dev/null 2>&1
    logger -t myhelper-watchdog "BBR enabled and verified"
    return 0
}

# ---------------------------------------------------------------------------
# CAKE preset -> tc flag mapping
# ---------------------------------------------------------------------------
cake_preset_flags() {
    case "$1" in
        balanced)       echo "diffserv4 triple-isolate nat wash ack-filter" ;;
        low_latency)    echo "diffserv8 dual-srchost nat ack-filter" ;;
        max_throughput) echo "besteffort triple-isolate nat wash" ;;
        custom)
            config_get custom_flags settings custom_cake_flags ""
            echo "$custom_flags"
            ;;
        *) echo "diffserv4 triple-isolate nat wash ack-filter" ;;
    esac
}

cake_linklayer_suffix() {
    local ll="$1" oh="$2"
    local s=""
    [ -n "$oh" ] && [ "$oh" != "0" ] && s="overhead $oh"
    echo "$s"
}

# ---------------------------------------------------------------------------
# HFSC + pfifo + CAKE (game_boost preset)
# ---------------------------------------------------------------------------
apply_hfsc_game_boost() {
    local dev="$1"
    local total_bw="$2"
    local game_bw="$3"
    local pfifo_limit="$4"
    local linklayer="$5"
    local overhead="$6"
    local err=0

    [ -n "$total_bw" ] && [ "$total_bw" != "0" ] || {
        logger -t myhelper-watchdog "HFSC: bandwidth_upload not set, skipping"
        return 1
    }

    case "$total_bw" in
        *mbit) total_bw=$(echo "$total_bw" | sed 's/mbit//'); total_bw=$((total_bw * 1000)) ;;
        *kbit) total_bw=$(echo "$total_bw" | sed 's/kbit//') ;;
    esac

    case "$total_bw" in
        ''|*[!0-9]*)
            logger -t myhelper-watchdog \
                "HFSC: invalid total_bw='$total_bw' (expected numeric kbit)"
            return 1
            ;;
    esac
    case "$game_bw" in
        ''|*[!0-9]*)
            logger -t myhelper-watchdog "HFSC: invalid game_bw='$game_bw', using 0"
            game_bw=0
            ;;
    esac
    if [ "$game_bw" -gt "$total_bw" ]; then
        logger -t myhelper-watchdog \
            "HFSC: game_bw (${game_bw}kbit) > total_bw (${total_bw}kbit), clamping"
        game_bw="$total_bw"
    fi

    local cake_ll_suffix
    cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")

    logger -t myhelper-watchdog \
        "HFSC game_boost: total=${total_bw}kbit game=${game_bw}kbit pfifo=$pfifo_limit"

    tc qdisc del dev "$dev" root 2>/dev/null

    if ! tc qdisc add dev "$dev" root handle 1: hfsc default 30; then
        logger -t myhelper-watchdog "HFSC: root qdisc add failed"
        return 1
    fi
    if ! tc class add dev "$dev" parent 1: classid 1:1 hfsc \
        sc rate "${game_bw}kbit" ul rate "${game_bw}kbit"; then
        logger -t myhelper-watchdog "HFSC: class 1:1 (game) add failed"
        err=1
    fi
    if ! tc class add dev "$dev" parent 1: classid 1:30 hfsc \
        sc rate "${total_bw}kbit" ul rate "${total_bw}kbit"; then
        logger -t myhelper-watchdog "HFSC: class 1:30 (bulk) add failed"
        err=1
    fi
    if ! tc qdisc add dev "$dev" parent 1:1 handle 10: pfifo limit "$pfifo_limit"; then
        logger -t myhelper-watchdog "HFSC: pfifo qdisc add failed"
        err=1
    fi
    # shellcheck disable=SC2086
    if ! tc qdisc add dev "$dev" parent 1:30 handle 20: cake \
        bandwidth "${total_bw}kbit" \
        diffserv4 nat ack-filter $cake_ll_suffix \
        memlimit 32mb ; then
        logger -t myhelper-watchdog "HFSC: CAKE under bulk class failed"
        err=1
    fi

    if [ "$err" -eq 0 ]; then
        logger -t myhelper-watchdog "HFSC game_boost applied on $dev"
    else
        logger -t myhelper-watchdog "HFSC game_boost partially applied on $dev"
    fi
    return "$err"
}

# ---------------------------------------------------------------------------
# Game Boost: DSCP marking (nft) + CAKE shaping (tc)
# ---------------------------------------------------------------------------
apply_qos() {
    config_load myhelper
    # Read new key first, fall back to legacy `enabled` for pre-migration state.
    config_get enabled settings game_boost_enabled ""
    if [ -z "$enabled" ]; then
        config_get enabled settings enabled 0
    fi
    config_get ports      settings ports               ""
    config_get wan_if     settings wan_iface           "wan"
    config_get bw_up      settings bandwidth_upload    "0"
    config_get bw_down    settings bandwidth_download  "0"
    config_get qos_preset settings qos_preset          "balanced"
    config_get game_bw    settings game_bandwidth_guarantee "8000"
    config_get pfifo_lim  settings game_pfifo_limit    "10"
    config_get linklayer  settings linklayer           "ethernet"
    config_get overhead   settings overhead            "34"

    if [ "$enabled" != "1" ]; then
        logger -t myhelper-watchdog "game_boost disabled, cleaning up"
        cleanup_qos
        rm -f "$GAMING_IP_FILE"
        apply_bbr
        return 0
    fi

    local err=0

    cake_flags=$(cake_preset_flags "$qos_preset")
    logger -t myhelper-watchdog \
        "applying game_boost preset=$qos_preset ports=[$ports]"

    nft delete table inet "$NFT_TABLE" 2>/dev/null

    if ! nft add table inet "$NFT_TABLE"; then
        logger -t myhelper-watchdog "CRITICAL: nft add table failed"
        apply_bbr
        return 1
    fi
    if ! nft add chain inet "$NFT_TABLE" mark_out \
        '{ type filter hook postrouting priority mangle ; policy accept ; }'; then
        logger -t myhelper-watchdog "CRITICAL: nft add chain failed"
        apply_bbr
        return 1
    fi

    SET_PRIO=0
    [ "$qos_preset" = "game_boost" ] && SET_PRIO=1

    GAMING_IP_CAPTURED=""

    handle_target_mac() {
        local mac="$1"
        [ -n "$mac" ] || return 0

        local ip
        ip=$(resolve_mac_to_ip "$mac" "ipv4")
        if [ -n "$ip" ]; then
            [ -z "$GAMING_IP_CAPTURED" ] && GAMING_IP_CAPTURED="$ip"

            if ! nft add rule inet "$NFT_TABLE" mark_out \
                ip saddr "$ip" ip dscp set cs6 \
                comment '"myhelper: game v4 src"'; then
                logger -t myhelper-watchdog "nft: v4 src dscp failed for $mac"
                err=1
            fi
            if ! nft add rule inet "$NFT_TABLE" mark_out \
                ip daddr "$ip" ip dscp set cs6 \
                comment '"myhelper: game v4 dst"'; then
                logger -t myhelper-watchdog "nft: v4 dst dscp failed for $mac"
                err=1
            fi
            if [ "$SET_PRIO" = "1" ]; then
                if ! nft add rule inet "$NFT_TABLE" mark_out \
                    ip saddr "$ip" meta priority set 1:1 \
                    comment '"myhelper: game v4 to hfsc class 1:1"'; then
                    logger -t myhelper-watchdog "nft: v4 src prio failed for $mac"
                    err=1
                fi
                if ! nft add rule inet "$NFT_TABLE" mark_out \
                    ip daddr "$ip" meta priority set 1:1 \
                    comment '"myhelper: game v4 to hfsc class 1:1"'; then
                    logger -t myhelper-watchdog "nft: v4 dst prio failed for $mac"
                    err=1
                fi
            fi
            logger -t myhelper-watchdog "MAC $mac -> IPv4 $ip"
        else
            logger -t myhelper-watchdog "MAC $mac: no IPv4 lease"
        fi

        local ip6
        ip6=$(resolve_mac_to_ip "$mac" "ipv6")
        if [ -n "$ip6" ]; then
            if ! nft add rule inet "$NFT_TABLE" mark_out \
                ip6 saddr "$ip6" ip6 dscp set cs6 \
                comment '"myhelper: game v6 src"'; then
                logger -t myhelper-watchdog "nft: v6 src dscp failed for $mac"
                err=1
            fi
            if ! nft add rule inet "$NFT_TABLE" mark_out \
                ip6 daddr "$ip6" ip6 dscp set cs6 \
                comment '"myhelper: game v6 dst"'; then
                logger -t myhelper-watchdog "nft: v6 dst dscp failed for $mac"
                err=1
            fi
            if [ "$SET_PRIO" = "1" ]; then
                if ! nft add rule inet "$NFT_TABLE" mark_out \
                    ip6 saddr "$ip6" meta priority set 1:1 \
                    comment '"myhelper: game v6 to hfsc class 1:1"'; then
                    logger -t myhelper-watchdog "nft: v6 src prio failed for $mac"
                    err=1
                fi
                if ! nft add rule inet "$NFT_TABLE" mark_out \
                    ip6 daddr "$ip6" meta priority set 1:1 \
                    comment '"myhelper: game v6 to hfsc class 1:1"'; then
                    logger -t myhelper-watchdog "nft: v6 dst prio failed for $mac"
                    err=1
                fi
            fi
            logger -t myhelper-watchdog "MAC $mac -> IPv6 $ip6"
        fi
    }
    config_list_foreach settings target_mac handle_target_mac

    if [ -n "$GAMING_IP_CAPTURED" ]; then
        echo "$GAMING_IP_CAPTURED" > "$GAMING_IP_FILE"
    else
        rm -f "$GAMING_IP_FILE"
    fi

    if [ -n "$ports" ]; then
        portset=$(echo "$ports" | sed "s/ *, */, /g")
        if ! nft add rule inet "$NFT_TABLE" mark_out \
            tcp dport "{ $portset }" ip dscp set cs6 \
            comment '"myhelper: game tcp ports v4"'; then
            logger -t myhelper-watchdog "nft: tcp v4 ports failed"; err=1
        fi
        if ! nft add rule inet "$NFT_TABLE" mark_out \
            udp dport "{ $portset }" ip dscp set cs6 \
            comment '"myhelper: game udp ports v4"'; then
            logger -t myhelper-watchdog "nft: udp v4 ports failed"; err=1
        fi
        if ! nft add rule inet "$NFT_TABLE" mark_out \
            tcp dport "{ $portset }" ip6 dscp set cs6 \
            comment '"myhelper: game tcp ports v6"'; then
            logger -t myhelper-watchdog "nft: tcp v6 ports failed"; err=1
        fi
        if ! nft add rule inet "$NFT_TABLE" mark_out \
            udp dport "{ $portset }" ip6 dscp set cs6 \
            comment '"myhelper: game udp ports v6"'; then
            logger -t myhelper-watchdog "nft: udp v6 ports failed"; err=1
        fi
    fi

    if [ "$bw_up" != "0" ] && [ -n "$bw_up" ]; then
        wan_dev=$(resolve_wan_dev "$wan_if")
        if [ "$qos_preset" = "game_boost" ]; then
            if ! apply_hfsc_game_boost "$wan_dev" "$bw_up" "$game_bw" \
                                       "$pfifo_lim" "$linklayer" "$overhead"; then
                logger -t myhelper-watchdog "HFSC game_boost failed (see above)"
                err=1
            fi
        else
            cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")
            logger -t myhelper-watchdog \
                "cake egress dev=$wan_dev rate=$bw_up preset=$qos_preset"
            tc qdisc del dev "$wan_dev" root 2>/dev/null
            # shellcheck disable=SC2086
            if ! tc qdisc add dev "$wan_dev" root cake \
                bandwidth "$bw_up" \
                $cake_flags $cake_ll_suffix \
                memlimit 32mb ; then
                logger -t myhelper-watchdog "cake egress FAILED"; err=1
            fi
        fi
    fi

    if [ "$bw_down" != "0" ] && [ -n "$bw_down" ]; then
        wan_dev=$(resolve_wan_dev "$wan_if")
        cake_ll_suffix=$(cake_linklayer_suffix "$linklayer" "$overhead")

        modprobe ifb 2>/dev/null
        ip link del "$IFB_DEV" 2>/dev/null
        if ! ip link add "$IFB_DEV" type ifb 2>/dev/null; then
            logger -t myhelper-watchdog "ingress: ip link add ifb failed"; err=1
        fi
        if ! ip link set "$IFB_DEV" up; then
            logger -t myhelper-watchdog "ingress: ip link set up failed"; err=1
        fi

        tc qdisc del dev "$wan_dev" ingress 2>/dev/null
        if ! tc qdisc add dev "$wan_dev" handle ffff: ingress; then
            logger -t myhelper-watchdog "ingress: qdisc ingress add failed"; err=1
        fi
        if ! tc filter add dev "$wan_dev" parent ffff: protocol all u32 \
            match u32 0 0 \
            action mirred egress redirect dev "$IFB_DEV"; then
            logger -t myhelper-watchdog "ingress: mirred filter add failed"; err=1
        fi

        tc qdisc del dev "$IFB_DEV" root 2>/dev/null
        # shellcheck disable=SC2086
        if ! tc qdisc add dev "$IFB_DEV" root cake \
            bandwidth "$bw_down" \
            $cake_flags $cake_ll_suffix \
            memlimit 64mb ; then
            logger -t myhelper-watchdog "cake ingress FAILED"; err=1
        fi

        logger -t myhelper-watchdog \
            "cake ingress dev=$wan_dev ifb=$IFB_DEV rate=$bw_down"
    fi

    if [ "$err" -eq 0 ]; then
        logger -t myhelper-watchdog "game_boost applied OK"
    else
        logger -t myhelper-watchdog "game_boost applied with errors (err=1)"
    fi
    apply_bbr
    return "$err"
}

# ---------------------------------------------------------------------------
# Speedtest (writes to myhelper.settings.*)
# ---------------------------------------------------------------------------
speedtest() {
    # Refuse to run if another speedtest-netperf is already active (e.g. a
    # previous run orphaned by a daemon restart).
    if pgrep -f "speedtest-netperf" >/dev/null 2>&1; then
        logger -t myhelper-watchdog \
            "speedtest already running (pgrep found speedtest-netperf)"
        return 1
    fi

    logger -t myhelper-watchdog "starting speedtest..."

    if ! command -v speedtest-netperf >/dev/null 2>&1; then
        logger -t myhelper-watchdog \
            "speedtest-netperf not installed, installing..."
        opkg update >/dev/null 2>&1
        opkg install speedtest-netperf >/dev/null 2>&1 || {
            logger -t myhelper-watchdog "FAILED to install speedtest-netperf"
            return 1
        }
    fi

    OUT=$(timeout 120 speedtest-netperf -H netperf.bufferbloat.net 2>&1)

    DL=$(echo "$OUT" | grep -iE 'download' | grep -oE '[0-9]+\.[0-9]+' | head -1)
    UL=$(echo "$OUT" | grep -iE 'upload'   | grep -oE '[0-9]+\.[0-9]+' | head -1)

    [ -z "$DL" ] && DL=0
    [ -z "$UL" ] && UL=0

    DL_KBIT=$(echo "$DL" | awk '{printf "%d", $1 * 1000}')
    UL_KBIT=$(echo "$UL" | awk '{printf "%d", $1 * 1000}')
    [ -z "$DL_KBIT" ] && DL_KBIT=0
    [ -z "$UL_KBIT" ] && UL_KBIT=0

    TS=$(date +%s)

    if ! uci -q show myhelper.settings >/dev/null 2>&1; then
        uci set myhelper.settings=settings
    fi

    uci set myhelper.settings.speedtest_download="$DL_KBIT"
    uci set myhelper.settings.speedtest_upload="$UL_KBIT"
    uci set myhelper.settings.speedtest_timestamp="$TS"
    uci commit myhelper || {
        logger -t myhelper-watchdog "speedtest: uci commit FAILED"
        return 1
    }

    logger -t myhelper-watchdog \
        "speedtest done: down=${DL}Mbit up=${UL}Mbit"
    echo "DOWN=${DL}Mbit UP=${UL}Mbit"
}
