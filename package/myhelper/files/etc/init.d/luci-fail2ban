#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/luci-fail2ban.sh
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    nft delete rule inet fw4 input ip saddr @luci_bruteforce counter drop 2>/dev/null
    nft delete set inet fw4 luci_bruteforce 2>/dev/null
}
