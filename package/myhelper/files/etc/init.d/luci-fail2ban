#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/luci-fail2ban.sh
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    # nftables deletes rules by handle, not by repeating the rule expression.
    if nft list chain inet fw4 input >/dev/null 2>&1; then
        nft -a list chain inet fw4 input 2>/dev/null |
            awk '/ip saddr @luci_bruteforce/ {
                for (i = 1; i <= NF; i++)
                    if ($i == "handle") print $(i + 1)
            }' |
            while read -r handle; do
                [ -n "$handle" ] && nft delete rule inet fw4 input handle "$handle" 2>/dev/null
            done
    fi
    nft delete set inet fw4 luci_bruteforce 2>/dev/null || true
}
