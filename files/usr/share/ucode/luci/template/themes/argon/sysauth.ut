<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<meta name="robots" content="noindex, nofollow">
	<title>OPENWRT - Game Boost Edition</title>
	<style>
		* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
		html, body {
			background-color: #030008;
			background-image: radial-gradient(circle at 15% 50%, rgba(139, 0, 255, 0.15), transparent 25%), radial-gradient(circle at 85% 30%, rgba(0, 212, 255, 0.15), transparent 25%), radial-gradient(1px 1px at 10% 20%, #fff, transparent), radial-gradient(1.5px 1.5px at 30% 60%, #fff, transparent), radial-gradient(1px 1px at 70% 80%, #fff, transparent), radial-gradient(2px 2px at 90% 10%, #fff, transparent), radial-gradient(1px 1px at 50% 40%, #fff, transparent);
			background-size: 100% 100%, 100% 100%, 200px 200px, 250px 250px, 300px 300px, 150px 150px, 200px 200px;
			background-attachment: fixed; min-height: 100vh; color: #fff; overflow-x: hidden;
		}
		body { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; }
		.neon-frame {
			position: relative; width: 100%; max-width: 420px; border-radius: 24px; padding: 2px;
			background: linear-gradient(180deg, #00d4ff 0%, #6a00ff 50%, #b800ff 100%);
			box-shadow: 0 0 10px rgba(0, 212, 255, 0.8), 0 0 20px rgba(0, 212, 255, 0.5), 0 0 40px rgba(106, 0, 255, 0.6), 0 0 80px rgba(184, 0, 255, 0.4), inset 0 0 15px rgba(0, 212, 255, 0.3);
			margin-bottom: 40px;
		}
		.login-container {
			background: #06060c; border-radius: 22px; padding: 35px 25px 30px; position: relative; z-index: 2;
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05), inset 0 0 20px rgba(0, 212, 255, 0.1);
		}
		.header { display: flex; flex-direction: column; align-items: center; margin-bottom: 30px; }
		.logo { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
		.logo-icon { width: 38px; height: 38px; border: 3px solid #ffea75; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 10px #ffea75, inset 0 0 8px rgba(255, 234, 117, 0.5); }
		.logo-icon::after { content: ""; width: 16px; height: 16px; border: 2px solid #ffea75; border-radius: 50%; box-shadow: 0 0 5px #ffea75; }
		.logo-text { font-size: clamp(24px, 6vw, 28px); font-weight: 800; color: #ffea75; letter-spacing: 1.5px; text-shadow: 0 0 10px rgba(255, 234, 117, 0.8); }
		.subtitle { color: #ff3366; font-size: clamp(12px, 3.5vw, 14px); font-weight: 700; letter-spacing: 2px; text-shadow: 0 0 10px rgba(255, 51, 102, 0.8); }
		
		.error-box {
			background: rgba(255, 0, 68, 0.12); border: 1.5px solid #ff0044; border-radius: 10px; padding: 12px 14px; margin-bottom: 22px;
			color: #ff5588; font-size: 13px; font-weight: 600; letter-spacing: 0.5px; display: flex; align-items: center; gap: 10px;
			box-shadow: 0 0 15px rgba(255, 0, 68, 0.35); animation: errorPulse 1.6s ease-in-out infinite;
		}
		@keyframes errorPulse { 0%, 100% { box-shadow: 0 0 12px rgba(255, 0, 68, 0.35); } 50% { box-shadow: 0 0 22px rgba(255, 0, 68, 0.65); } }
		.error-box .error-icon { font-size: 18px; color: #ff3366; }

		.form-group { margin-bottom: 22px; }
		.form-group label { display: block; color: #ffea75; font-size: 11px; font-weight: 700; margin-bottom: 8px; letter-spacing: 1.5px; }
		.form-group input { width: 100%; background: #000; border: 1.5px solid #ff0044; border-radius: 10px; padding: 16px; color: #fff; font-size: 16px; outline: none; box-shadow: 0 0 12px rgba(255, 0, 68, 0.4); transition: all 0.3s ease; }
		.form-group input:focus { box-shadow: 0 0 25px rgba(255, 0, 68, 0.8); border-color: #ff3377; background: #0a0a0a; }
		
		.input-wrapper { position: relative; }
		.input-wrapper input { padding-right: 48px; }
		.toggle-password {
			position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: transparent; border: none; cursor: pointer;
			padding: 6px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; color: #ffea75; border-radius: 8px;
			transition: all 0.2s ease; opacity: 0.7;
		}
		.toggle-password:hover { opacity: 1; background: rgba(255, 234, 117, 0.1); }
		.toggle-password svg { width: 20px; height: 20px; }

		.remember-row { margin-bottom: 22px; display: flex; align-items: center; }
		.remember-label { display: flex; align-items: center; gap: 10px; cursor: pointer; color: #94a3b8; font-size: 12px; font-weight: 600; letter-spacing: 1px; }
		.remember-label input[type="checkbox"] { appearance: none; width: 18px; height: 18px; border: 1.5px solid #ff0044; border-radius: 4px; background: #000; cursor: pointer; position: relative; }
		.remember-label input[type="checkbox"]:checked { background: #ff0044; box-shadow: 0 0 15px rgba(255, 0, 68, 0.8); }
		.remember-label input[type="checkbox"]:checked::after { content: ''; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

		.login-btn {
			width: 100%; padding: 18px; border: 1.5px solid #ff0044; border-radius: 10px; color: #fff; font-size: 16px; font-weight: 800; letter-spacing: 2px; cursor: pointer;
			background: linear-gradient(110deg, #ff1a40 48%, #cc0022 48%); animation: neonPulse 2s infinite alternate;
		}
		@keyframes neonPulse { 0% { box-shadow: 0 0 15px rgba(255, 0, 68, 0.5); } 100% { box-shadow: 0 0 30px rgba(255, 0, 68, 0.9); } }
		.login-btn:hover { filter: brightness(1.2); transform: translateY(-2px); }
		
		.footer-text { text-align: center; color: #ff0044; font-size: 10px; font-weight: 700; letter-spacing: 3px; margin-top: 25px; }
		.bottom-large-text { text-align: center; color: #00d4ff; font-size: clamp(32px, 10vw, 48px); font-weight: 900; line-height: 1.1; letter-spacing: 2px; text-shadow: 0 0 20px rgba(0, 212, 255, 0.6); margin-top: 10px; }

		@media (min-width: 768px) {
			.neon-frame { max-width: 580px; }
			.login-container { padding: 60px 50px 50px; }
			.logo-text { font-size: 42px; }
			.form-group input { padding: 22px; font-size: 20px; }
			.input-wrapper input { padding-right: 56px; }
			.toggle-password { width: 42px; height: 42px; right: 10px; }
			.login-btn { padding: 22px; font-size: 20px; }
			.bottom-large-text { font-size: 72px; }
		}
	</style>
</head>
<body>
	<div class="neon-frame">
		<div class="login-container">
			<div class="header">
				<div class="logo">
					<div class="logo-icon"></div>
					<div class="logo-text">OPENWRT</div>
				</div>
				<div class="subtitle">GAME BOOST EDITION</div>
			</div>

			<form method="post" action="{{ REQUEST_URI }}" id="login-form">
				
				{% if (fuser && !auth_plugin): %}
				<div class="error-box" role="alert">
					<span class="error-icon" aria-hidden="true">⚠</span>
					<span>{{ _('Invalid username and/or password! Please try again.') }}</span>
				</div>
				{% endif %}
				{% if (auth_message): %}
				<div class="error-box" role="alert">
					<span class="error-icon" aria-hidden="true">⚠</span>
					<span>{{ auth_message }}</span>
				</div>
				{% endif %}

				<div class="form-group">
					<label for="luci_username">USERNAME</label>
					<input type="text" id="luci_username" name="luci_username"
						value="{{ fuser || duser || '' }}"
						data-has-fuser="{{ fuser ? '1' : '0' }}"
						placeholder="Введите логин"
						autocomplete="username">
				</div>

				<div class="form-group">
					<label for="luci_password">PASSWORD</label>
					<div class="input-wrapper">
						<input type="password" id="luci_password" name="luci_password"
							placeholder="Введите пароль"
							autocomplete="current-password">
						<button type="button" class="toggle-password" id="eye-btn"
							aria-label="Show password" title="Show password">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.77 21.77 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.77 21.77 0 0 1-3.17 3.9m-6.72-6.72a3 3 0 1 0 4.24 4.24"/>
								<line x1="1" y1="1" x2="23" y2="23"/>
							</svg>
						</button>
					</div>
				</div>

				<div class="remember-row">
					<label class="remember-label" for="remember-me">
						<input type="checkbox" id="remember-me" name="remember-me">
						<span>REMEMBER ME</span>
					</label>
				</div>

				<button type="submit" class="login-btn">LOGIN</button>
			</form>

			<div class="footer-text">DOMINATE. CONNECT. WIN.</div>
		</div>
	</div>

	<div class="bottom-large-text">
		DOMINATE<br>CONNECT WIN
	</div>

	<script>
	(function() {
		'use strict';
		var EYE_ON  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
		var EYE_OFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.77 21.77 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.77 21.77 0 0 1-3.17 3.9m-6.72-6.72a3 3 0 1 0 4.24 4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';

		var toggleBtn = document.getElementById('eye-btn');
		var pwdInput  = document.getElementById('luci_password');
		
		if (toggleBtn && pwdInput) {
			toggleBtn.addEventListener('click', function(ev) {
				ev.preventDefault();
				if (pwdInput.type === 'password') {
					pwdInput.type = 'text';
					toggleBtn.innerHTML = EYE_ON;
					toggleBtn.setAttribute('aria-label', 'Hide password');
				} else {
					pwdInput.type = 'password';
					toggleBtn.innerHTML = EYE_OFF;
					toggleBtn.setAttribute('aria-label', 'Show password');
				}
			});
		}

		var KEY = 'myhelper_saved_username';
		var form = document.getElementById('login-form');
		var userInput = document.getElementById('luci_username');
		var rememberCheck = document.getElementById('remember-me');

		if (userInput) {
			var hasFuser = userInput.getAttribute('data-has-fuser') === '1';
			try {
				var saved = localStorage.getItem(KEY);
				if (saved) {
					if (!hasFuser) userInput.value = saved;
					if (rememberCheck) rememberCheck.checked = true;
				}
			} catch (e) {}
		}

		setTimeout(function() {
			if (userInput && userInput.value) {
				if (pwdInput) pwdInput.focus();
			} else if (userInput) {
				userInput.focus();
			}
		}, 50);

		if (form) {
			form.addEventListener('submit', function() {
				try {
					if (rememberCheck && rememberCheck.checked && userInput && userInput.value) {
						localStorage.setItem(KEY, userInput.value);
					} else {
						localStorage.removeItem(KEY);
					}
				} catch (e) {}
			});
		}
	})();
	</script>
</body>
</html>
